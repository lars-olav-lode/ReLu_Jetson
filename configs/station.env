# Robot-skriptene leser denne filen automatisk.
# Variabler satt i terminalen/foran kommandoen overstyrer verdiene her.
# Alternativ fil: STATION_ENV=configs/annen-stasjon.env bash scripts/teleop.sh
# Stasjon: s1 eller s2. Kontroller både stasjon og porter før robotkjøring.
STATION=s1

# Bytt til portene dere har identifisert
FOLLOWER_PORT=/dev/ttyACM1
LEADER_PORT=/dev/ttyACM0

# Kameraindekser
CAM_FRONT=0
CAM_WRIST=2

# Opptaksinnstillinger
FPS=30
EPISODES=10
EPISODE_S=30
RESET_S=10

# Policykjøring og trening (sett DEVICE=cpu for CPU).
DEVICE=cuda
DISPLAY_DATA=false
DURATION_S=30

# Valgfri kobling; må være lik under trening, kjøring og evaluering.
# RENAME_MAP='{"observation.images.front":"observation.images.camera1","observation.images.wrist":"observation.images.camera2"}'
